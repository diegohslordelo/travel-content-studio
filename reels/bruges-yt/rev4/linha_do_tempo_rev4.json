 "narracoes": [
  {
   "id": "G1",
   "ini": 200,
   "fim": 4875.0,
   "texto": "Quanto custa um dia em Bruges, a cidade que parece um conto de fadas?"
  },
  {
   "id": "G2",
   "ini": 5100,
   "fim": 9462.5,
   "texto": "Voltamos três vezes no mesmo waffle e achamos a melhor batata da viagem."
  },
  {
   "id": "G3",
   "ini": 17100,
   "fim": 20525.0,
   "texto": "E vimos de pertinho a relíquia do sangue de Cristo."
  },
  {
   "id": "G4",
   "ini": 20750,
   "fim": 25737.5,
   "texto": "Eu anotei cada euro. No final, te mostro quanto deu e se vale a pena."
  },
  {
   "id": "G5",
   "ini": 25950,
   "fim": 28750.0,
   "texto": "E a conta começa aqui, ainda em Bruxelas."
  },
  {
   "id": "F1",
   "ini": 843882.5,
   "fim": 849495.0,
   "texto": "Sabe aquela Europa que você imagina antes de conhecer a Europa? Ela existe. E se chama Bruges."
  },
  {
   "id": "F2",
   "ini": 849845.0,
   "fim": 855770.0,
   "texto": "Canal em cada esquina, carruagem passando na praça e uma cidade inteira com cheiro de chocolate e waffle."
  },
  {
   "id": "F3",
   "ini": 856120.0,
   "fim": 861420.0,
   "texto": "O centro histórico inteiro é Patrimônio Mundial da UNESCO, e dá pra conhecer tudo a pé."
  },
  {
   "id": "F4",
   "ini": 861770.0,
   "fim": 867070.0,
   "texto": "E tudo isso num bate-volta: trem, waffle, batata e cerveja deram 132 euros pra nós dois."
  },
  {
   "id": "F5",
   "ini": 867420.0,
   "fim": 873032.5,
   "texto": "Somando a noite de hotel, ficou em uns 276 euros: 138 por pessoa, perto de 834 reais."
  },
  {
   "id": "F6",
   "ini": 873382.5,
   "fim": 879932.5,
   "texto": "Vale a pena? Muito. Um dia é suficiente pra conhecer, mas não pra querer ir embora. Eu voltaria mil vezes."
  },
  {
   "id": "F7",
   "ini": 880282.5,
   "fim": 889020.0,
   "texto": "Dica: se puder, durma uma noite em Bruges. De manhã cedo e à noite, quando os grupos de bate-volta vão embora, a cidade fica bem mais vazia."
  },
  {
   "id": "F8",
   "ini": 889370.0,
   "fim": 894982.5,
   "texto": "Se esse vídeo te ajudou, se inscreve, deixa o like e me segue no Instagram: arroba primeirodiaem."
  },
  {
   "id": "F9",
   "ini": 895332.5,
   "fim": 902820.0,
   "texto": "Toda cidade tem um primeiro dia. E o de Bruges, a gente nunca vai esquecer. O próximo é em Paris. Te espero lá!"
  }
 ],
