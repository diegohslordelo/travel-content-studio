 "narracoes": [
  {
   "id": "G1",
   "arq": "P1",
   "t0_ms": -389.99999999999994,
   "fala_ini": 300,
   "fala_fim": 4180,
   "arq_ini_s": 0.69,
   "arq_fim_s": 4.57,
   "texto": "Quanto custa um dia em Bruges, a cidade que parece um conto de fadas?"
  },
  {
   "id": "G2",
   "arq": "P2",
   "t0_ms": 4020.0000000000005,
   "fala_ini": 4480,
   "fala_fim": 9040,
   "arq_ini_s": 0.46,
   "arq_fim_s": 5.02,
   "texto": "Nós comemos três vezes o mesmo waffle e achamos a melhor batata frita da cidade."
  },
  {
   "id": "G3",
   "arq": "P3",
   "t0_ms": 14589.999999999998,
   "fala_ini": 15060,
   "fala_fim": 17400,
   "arq_ini_s": 0.47,
   "arq_fim_s": 2.81,
   "texto": "E vimos de pertinho o sangue de Cristo."
  },
  {
   "id": "G4",
   "arq": "P4",
   "t0_ms": 16980.0,
   "fala_ini": 17750,
   "fala_fim": 22920,
   "arq_ini_s": 0.77,
   "arq_fim_s": 5.94,
   "texto": "Eu anotei cada euro e eu vou te mostrar no final quanto deu isso tudo e se vale a pena."
  },
  {
   "id": "G5",
   "arq": "P5",
   "t0_ms": 22930.000000000004,
   "fala_ini": 23270,
   "fala_fim": 28770,
   "arq_ini_s": 0.34,
   "arq_fim_s": 5.84,
   "texto": "E a conta começa aqui. Nós saímos de um bate-volta de Bruxelas, cerca de uma hora de Bruxelas, e compramos na hora o bilhete."
  },
  {
   "id": "F1",
   "arq": "R1",
   "t0_ms": 841102.0,
   "fala_ini": 841882,
   "fala_fim": 847322,
   "arq_ini_s": 0.78,
   "arq_fim_s": 6.22,
   "texto": "Sabe aquela Europa que você imagina antes de visitar a Europa? Pois é, ela existe e se chama Bruges."
  },
  {
   "id": "F2",
   "arq": "R2",
   "t0_ms": 847062.0,
   "fala_ini": 847722,
   "fala_fim": 854042,
   "arq_ini_s": 0.66,
   "arq_fim_s": 6.98,
   "texto": "Conhecida como Veneza do Norte, ela tem um canal em cada esquina, carruagens passando, cheira a chocolate e a waffle."
  },
  {
   "id": "F3",
   "arq": "R3",
   "t0_ms": 853982.0,
   "fala_ini": 854592,
   "fala_fim": 858642,
   "arq_ini_s": 0.61,
   "arq_fim_s": 4.66,
   "texto": "O centro histórico inteiro é patrimônio mundial da UNESCO e dá pra fazer tudo andando."
  },
  {
   "id": "F4",
   "arq": "R4",
   "t0_ms": 858532.0,
   "fala_ini": 859092,
   "fala_fim": 865142,
   "arq_ini_s": 0.56,
   "arq_fim_s": 6.61,
   "texto": "No final das contas, tudo que nós consumimos aqui, mais o transporte saindo de Bruxelas, ficou 132 euros para o casal."
  },
  {
   "id": "F6",
   "arq": "R5",
   "t0_ms": 864992.0,
   "fala_ini": 865592,
   "fala_fim": 871672,
   "arq_ini_s": 0.6,
   "arq_fim_s": 6.68,
   "texto": "Vale muito a pena visitar essa cidade. Um dia é o suficiente para você conhecer, mas não para querer ir embora. Eu voltaria mil vezes."
  },
  {
   "id": "F7",
   "arq": "R6",
   "t0_ms": 871582.0,
   "fala_ini": 872122,
   "fala_fim": 878432,
   "arq_ini_s": 0.54,
   "arq_fim_s": 6.85,
   "texto": "E a dica que eu dou é: durma na cidade. De manhã cedo e à noite, os bate-voltas vão embora e ela fica mais vazia e mais legal ainda de conhecer."
  },
  {
   "id": "F8",
   "arq": "R7",
   "t0_ms": 878522.0,
   "fala_ini": 878882,
   "fala_fim": 885902,
   "arq_ini_s": 0.36,
   "arq_fim_s": 7.38,
   "texto": "E se esse vídeo te ajudou de alguma forma, se inscreve e deixa o like aí, que vai me ajudar muito. E não se esquece de me seguir lá no Instagram, @primeirodiaem."
  },
  {
   "id": "F9",
   "arq": "R8",
   "t0_ms": 885692.0,
   "fala_ini": 886352,
   "fala_fim": 892032,
   "arq_ini_s": 0.66,
   "arq_fim_s": 6.34,
   "texto": "Toda cidade tem um primeiro dia, e o de Bruges a gente nunca vai esquecer. O próximo é em Paris, te espero lá."
  }
 ],
