 "narracoes": [
  {
   "arq": "inicio/G_1.m4a",
   "fala_ini": 250,
   "fala_fim": 2480.0000000000005,
   "arq_ini_s": 0.51,
   "arq_fim_s": 2.74,
   "texto": "Quanto custou três dias em Amsterdã?"
  },
  {
   "arq": "inicio/G_3.m4a",
   "fala_ini": 5750,
   "fala_fim": 11180.0,
   "arq_ini_s": 0.57,
   "arq_fim_s": 6.0,
   "texto": "Teve muito frio, chuva, bicicleta pra todo lado, além de muito stroopwafel e cerveja, é claro, né?"
  },
  {
   "arq": "inicio/G_4.m4a",
   "fala_ini": 14050,
   "fala_fim": 19870.0,
   "arq_ini_s": 0.31,
   "arq_fim_s": 6.13,
   "texto": "E tem um detalhe na conta: o hotel custou mais do que todo o resto. Então pega sua pipoca e fica até o final, que eu vou lhe mostrar."
  },
  {
   "arq": "fechamento_v2/F_1.m4a",
   "fala_ini": 1916841.6666666665,
   "fala_fim": 1920151.6666666665,
   "arq_ini_s": 0.52,
   "arq_fim_s": 3.83,
   "texto": "Amsterdam é de fato encantadora em cada rua que passamos."
  },
  {
   "arq": "fechamento_v2/F_2.m4a",
   "fala_ini": 1920641.6666666665,
   "fala_fim": 1927491.6666666665,
   "arq_ini_s": 0.5,
   "arq_fim_s": 7.35,
   "texto": "Nada paga a experiência de passear pelos canais, atravessar cada ponte ou ter medo de ser atropelado por uma bicicleta."
  },
  {
   "arq": "fechamento_v2/F_3.m4a",
   "fala_ini": 1928091.6666666665,
   "fala_fim": 1936061.6666666665,
   "arq_ini_s": 0.12,
   "arq_fim_s": 8.09,
   "texto": "Pra gente ficar lá e fazer os passeios, a nossa conta deu 334 euros, contra 553 do hotel. Eu te avisei que o hotel ia ficar mais caro, né?"
  },
  {
   "arq": "fechamento_v2/F_4.m4a",
   "fala_ini": 1936661.6666666665,
   "fala_fim": 1943541.6666666665,
   "arq_ini_s": 0.47,
   "arq_fim_s": 7.35,
   "texto": "No total, sem contar a passagem aérea, deu 886 euros para nós dois e uns 443 por pessoa."
  },
  {
   "arq": "fechamento_v2/F_5.m4a",
   "fala_ini": 1944141.6666666665,
   "fala_fim": 1951081.6666666665,
   "arq_ini_s": 0.3,
   "arq_fim_s": 7.24,
   "texto": "Outra coisa: compre os ingressos das atrações antes, Museu de Anne Frank e Heineken Experience, porque esgota e vale muito a pena."
  },
  {
   "arq": "fechamento_v2/F_6.m4a",
   "fala_ini": 1951681.6666666665,
   "fala_fim": 1958571.6666666665,
   "arq_ini_s": 0.35,
   "arq_fim_s": 7.24,
   "texto": "Se esse vídeo te ajudou de alguma forma, se inscreve, deixa o like aqui e também me segue lá no Instagram, @primeirodiaem, pra não perder nada."
  },
  {
   "arq": "fechamento_v2/F_7.m4a",
   "fala_ini": 1959171.6666666665,
   "fala_fim": 1962841.6666666665,
   "arq_ini_s": 0.45,
   "arq_fim_s": 4.12,
   "texto": "Toda cidade tem um primeiro dia, e o próximo é lá em Bruxelas. Te espero lá!"
  }
