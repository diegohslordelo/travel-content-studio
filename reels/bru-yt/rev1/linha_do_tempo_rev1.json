 "narracoes": [
  {
   "id": "G1",
   "arq": "G1.m4a",
   "fala_ini": 250,
   "fala_fim": 2550,
   "texto": "Quanto custa um dia inteiro em Bruxelas?"
  },
  {
   "id": "G2",
   "arq": "G2.m4a",
   "fala_ini": 7650,
   "fala_fim": 11950,
   "texto": "Batata frita, waffle… e um chocolate que a gente não teve coragem de comprar:"
  },
  {
   "id": "G3",
   "arq": "G3.m4a",
   "fala_ini": 20550,
   "fala_fim": 26750,
   "texto": "Eu anotei cada euro que a gente gastou. No final, eu te mostro quanto deu o dia todo, e se vale a pena."
  },
  {
   "id": "H1",
   "arq": "H1.m4a",
   "fala_ini": 314366.6666666666,
   "fala_fim": 328666.6666666666,
   "texto": "Falando em hotel: a gente ficou no ibis Brussels off Grand Place, a uns 200 metros da praça. Foi o mais barato que achamos no centro, e com um dia só, ficar perto de tudo fez diferença. Foram duas noites, uma pra Bruxelas e outra pro bate-volta em Bruges: 1.738 reais para o casal."
  },
  {
   "id": "F1",
   "arq": "F1.m4a",
   "fala_ini": 868466.6666666667,
   "fala_fim": 874366.6666666667,
   "texto": "Num dia só, a gente rodou Bruxelas inteira: do Atomium à Grand Place, passando pelas três estátuas que fazem xixi."
  },
  {
   "id": "F2",
   "arq": "F2.m4a",
   "fala_ini": 874866.6666666667,
   "fala_fim": 880266.6666666667,
   "texto": "Metrô, comida, cerveja e doce: o dia deu 94 euros para nós dois."
  },
  {
   "id": "F3",
   "arq": "F3.m4a",
   "fala_ini": 880966.6666666667,
   "fala_fim": 887966.6666666667,
   "texto": "Somando uma noite de hotel, ficou em uns 239 euros: 119 por pessoa, perto de 720 reais."
  },
  {
   "id": "F4",
   "arq": "F4.m4a",
   "fala_ini": 888566.6666666667,
   "fala_fim": 894366.6666666667,
   "texto": "Vale a pena? Muito. Mas leve luva e casaco: o sol engana, e o vento não perdoa."
  },
  {
   "id": "F5",
   "arq": "F5.m4a",
   "fala_ini": 894966.6666666667,
   "fala_fim": 901566.6666666667,
   "texto": "Se esse vídeo te ajudou, se inscreve, deixa o like aqui e me segue no Instagram: @primeirodiaem."
  },
  {
   "id": "F6",
   "arq": "F6.m4a",
   "fala_ini": 902166.6666666667,
   "fala_fim": 907766.6666666667,
   "texto": "Toda cidade tem um primeiro dia. E o próximo é em Bruges, de bate-volta. Te espero lá!"
  }
 ],
