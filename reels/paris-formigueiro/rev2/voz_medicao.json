   "ini": 2.168,
   "fim": 2.712,
   "texto": "Pelo menos,",
   "antes_lufs": -15.2,
   "ganho_db": -3.8,
   "depois_lufs": -14.9
  },
  {
   "fala": "f2",
   "ini": 2.813,
   "fim": 4.686,
   "texto": "não se você for igual a todo mundo.",
   "antes_lufs": -20.9,
   "ganho_db": 1.8,
   "depois_lufs": -16.4
  },
  {
   "fala": "f3",
   "ini": 4.947,
   "fim": 7.05,
   "texto": "Segundo esse ranking aqui do Euromonitor,",
   "antes_lufs": -17.7,
   "ganho_db": -1.4,
   "depois_lufs": -15.2
  },
  {
   "fala": "f3",
   "ini": 7.13,
   "fim": 10.614,
   "texto": "Paris é o primeiro destino no mundo pelo quinto ano seguido.",
   "antes_lufs": -18.1,
   "ganho_db": -1.0,
   "depois_lufs": -15.2
  },
  {
   "fala": "f3",
   "ini": 11.314,
   "fim": 13.577,
   "texto": "Você tem ideia do que isso faz com a cidade?",
   "antes_lufs": -23.2,
   "ganho_db": 4.2,
   "depois_lufs": -15.1
  },
  {
   "fala": "f4",
   "ini": 13.767,
   "fim": 14.63,
   "texto": "Hospedagem cara,",
   "antes_lufs": -15.8,
   "ganho_db": -3.3,
   "depois_lufs": -15.9
  },
  {
   "fala": "f4",
   "ini": 14.73,
   "fim": 16.576,
   "texto": "pontos turísticos e restaurantes lotados,",
   "antes_lufs": -19.1,
   "ganho_db": 0.0,
   "depois_lufs": -15.9
  },
  {
   "fala": "f4",
   "ini": 16.616,
   "fim": 19.947,
   "texto": "isso atrapalha a sua experiência e ainda dói na conta bancária.",
   "antes_lufs": -20.6,
   "ganho_db": 1.5,
   "depois_lufs": -16.2
  },
  {
   "fala": "f5",
   "ini": 20.24,
   "fim": 20.501,
   "texto": "Agora,",
   "antes_lufs": -18.3,
   "ganho_db": -0.8,
   "depois_lufs": -15.9
  },
  {
   "fala": "f5",
   "ini": 20.562,
   "fim": 21.164,
   "texto": "cá entre nós,",
   "antes_lufs": -21.0,
   "ganho_db": 2.0,
   "depois_lufs": -15.8
  },
  {
   "fala": "f5",
   "ini": 21.204,
   "fim": 22.288,
   "texto": "dá pra fazer diferente,",
   "antes_lufs": -22.8,
   "ganho_db": 3.7,
   "depois_lufs": -15.7
  },
  {
   "fala": "f5",
   "ini": 22.348,
   "fim": 22.428,
   "texto": "né?",
