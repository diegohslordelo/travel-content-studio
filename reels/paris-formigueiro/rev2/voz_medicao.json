   "ganho_db": 6.0,
   "depois_lufs": -19.5
  },
  {
   "fala": "f5",
   "ini": 22.709,
   "fim": 25.84,
   "texto": "Eu vou te dar três pulos do gato pra você não se apertar em Paris.",
